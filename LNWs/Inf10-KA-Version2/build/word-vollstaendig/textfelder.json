    "page": 4,
    "id": 103,
    "x": 49.484440000000006,
    "y": 164.2005351999998,
    "baseline": 173.61522999999988,
    "text": "AND Berechtigung_von_Apps.id = App.id"
  },
  {
    "page": 4,
    "id": 104,
    "x": 297.75281,
    "y": 166.19318519999993,
    "baseline": 175.60788000000002,
    "text": "Berechtigungen_von_Apps.berechtigung_id"
  },
  {
    "page": 4,
    "id": 105,
    "x": 297.51744,
    "y": 178.94536519999988,
    "baseline": 188.36005999999998,
    "text": "AND Apps.id ="
  },
  {
