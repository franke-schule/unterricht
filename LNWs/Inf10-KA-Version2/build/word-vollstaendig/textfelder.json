    "y": 211.1130636,
    "baseline": 223.66598999999997,
    "text": "4. Appentwickler"
  },
  {
    "page": 4,
    "id": 108,
    "x": 481.89364,
    "y": 213.205218,
    "baseline": 223.66598999999997,
    "text": "["
  },
  {
    "page": 4,
    "id": 109,
    "x": 507.986790424,
    "y": 213.205218,
    "baseline": 223.66598999999997,
    "text": "/6 BE]"
  },
  {
    "page": 4,
    "id": 110,
    "x": 43.65353,
    "y": 242.21788799999996,
    "baseline": 252.67865999999992,
    "text": "Betrachte die folgenden Tabellenschemata der Tabellen Appentwickler und App."
  },
  {
    "page": 4,
    "id": 111,
    "x": 43.41816,
    "y": 259.4710851999999,
    "baseline": 268.88577999999995,
    "text": "Appentwickler (id: int [PS], name: varchar(255),"
  },
  {
    "page": 4,
    "id": 112,
    "x": 54.9921,
    "y": 271.42625519999984,
    "baseline": 280.8409499999999,
    "text": "gruendungsjahr: int)"
  },
  {
    "page": 4,
    "id": 113,
    "x": 43.41816,
    "y": 286.21605519999986,
    "baseline": 295.6307499999999,
    "text": "App (id: int [PS], appentwickler_id: int [FS],"
  },
  {
    "page": 4,
    "id": 114,
    "x": 54.9921,
    "y": 298.1712251999999,
    "baseline": 307.58592,
    "text": "name: varchar(255), erscheinungsjahr: int,"
  },
  {
    "page": 4,
    "id": 115,
    "x": 54.9921,
    "y": 310.1263952,
    "baseline": 319.54109000000005,
    "text": "kategorie: varchar(255))"
  },
  {
    "page": 4,
    "id": 116,
    "x": 43.34942,
    "y": 324.9161952,
    "baseline": 334.33089,
    "text": "Verwendete Abkürzungen: PS = Primärschlüssel, FS = Fremdschlüssel. App.appentwickler_id verweist auf Appentwickler.id ."
  },
  {
    "page": 4,
    "id": 117,
    "x": 43.65354000000002,
    "y": 344.329208,
    "baseline": 354.78998,
    "text": "a) Beschreibe folgende SQL-Anweisung in eigenen Worten."
  },
  {
    "page": 4,
    "id": 118,
    "x": 54.99211000000002,
    "y": 359.16881520000004,
    "baseline": 368.58351,
    "text": "SELECT COUNT(*)"
  },
  {
    "page": 4,
    "id": 119,
    "x": 54.99211000000002,
    "y": 370.12771520000007,
    "baseline": 379.54241,
    "text": "FROM App"
  },
  {
    "page": 4,
    "id": 120,
    "x": 54.99211000000002,
    "y": 381.08661520000004,
    "baseline": 390.50131,
    "text": "WHERE erscheinungsjahr > 2025"
  },
  {
    "page": 4,
    "id": 121,
    "x": 52.35681000000001,
    "y": 400.42109519999997,
    "baseline": 409.8357899999999,
    "text": "Die Anweisung zählt die Apps, die nach dem Jahr 2025 erschienen sind, also ab 2026. Ausgegeben wird eine einzelne Zahl."
  },
  {
    "page": 4,
    "id": 122,
    "x": 52.052700000000016,
    "y": 411.3799952,
    "baseline": 420.79468999999995,
    "text": "Apps mit Erscheinungsjahr 2025 werden nicht mitgezählt."
  },
  {
    "page": 4,
    "id": 123,
    "x": 43.65353,
    "y": 535.2994379999999,
    "baseline": 545.7602099999999,
    "text": "b) Formuliere eine SQL-Anweisung, die Namen der Apps zusammen mit den Namen der Appentwickler ausgibt, die die"
  },
  {
    "page": 4,
    "id": 124,
    "x": 43.65353,
    "y": 547.2546079999998,
    "baseline": 557.7153799999999,
    "text": "jeweilige App entwickelt haben."
  },
  {
    "page": 4,
    "id": 125,
    "x": 52.35681000000001,
    "y": 566.7332251999999,
    "baseline": 576.1479199999999,
    "text": "SELECT App.name, Appentwickler.name"
  },
  {
    "page": 4,
    "id": 126,
    "x": 52.35681000000001,
    "y": 577.6921251999999,
    "baseline": 587.1068199999999,
    "text": "FROM App, Appentwickler"
  },
  {
    "page": 4,
    "id": 127,
    "x": 52.12144000000001,
    "y": 588.6510251999998,
    "baseline": 598.0657199999998,
    "text": "WHERE App.appentwickler_id = Appentwickler.id;"
  },
  {
    "page": 4,
    "id": 128,
    "x": 52.35681000000001,
    "y": 602.5987251999999,
    "baseline": 612.0134199999999,
    "text": "Die beiden Tabellen werden über den Fremdschlüssel App.appentwickler_id und den Primärschlüssel Appentwickler.id"
  },
  {
    "page": 4,
    "id": 129,
    "x": 52.14485000000002,
    "y": 613.5576251999998,
    "baseline": 622.9723199999999,
    "text": "verknüpft."
  },
  {
    "page": 4,
    "id": 130,
    "x": 43.65353,
    "y": 713.7967179999999,
    "baseline": 724.25749,
    "text": "Gesamt:"
  },
  {
    "page": 4,
    "id": 131,
    "x": 476.41411999999997,
    "y": 713.7967179999999,
    "baseline": 724.25749,
    "text": "["
