{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "unterricht-static",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const t={'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.mjs':'text/javascript','.png':'image/png','.svg':'image/svg+xml','.pdf':'application/pdf','.json':'application/json'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);let x=p.join(process.cwd(),u);if(f.existsSync(x)&&f.statSync(x).isDirectory())x=p.join(x,'index.html');f.readFile(x,(e,d)=>{if(e){r.writeHead(404);r.end('404');return;}r.writeHead(200,{'Content-Type':t[p.extname(x)]||'application/octet-stream'});r.end(d);});}).listen(8765,()=>console.log('http://localhost:8765'));"
      ],
      "port": 8765
    }
  ]
}
